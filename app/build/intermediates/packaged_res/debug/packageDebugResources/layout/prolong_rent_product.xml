<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/changeUserNameContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="300dp"

        android:layout_marginBottom="-10dp"
        android:background="@drawable/chooze_size_not_active"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/textProlongRent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="27dp"
                android:layout_marginTop="27dp"
                android:fontFamily="@font/montserrat_bold"
                android:text="Продлить аренду товара"
                android:textColor="@color/black"
                android:textSize="18sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/krestYobannyiProlong"
                android:layout_width="13dp"
                android:layout_height="13dp"

                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="27dp"
                android:layout_weight="0"
                app:layout_constraintBottom_toBottomOf="@+id/textProlongRent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@+id/textProlongRent"
                app:srcCompat="@drawable/krest_blyat" />

            <TextView
                android:id="@+id/textProduct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/montserrat_regular"
                android:text="Товар"
                android:textColor="#858585"
                android:textSize="14sp"
                app:layout_constraintStart_toStartOf="@+id/textProlongRent"
                app:layout_constraintTop_toBottomOf="@+id/textProlongRent" />

            <TextView
                android:id="@+id/textNameOfProduct"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_medium"
                android:text="Перфоратор"
                android:textColor="#000000"
                android:textSize="15sp"
                app:layout_constraintStart_toStartOf="@+id/textProlongRent"
                app:layout_constraintTop_toBottomOf="@+id/textProduct" />

            <TextView
                android:id="@+id/textTermRent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:fontFamily="@font/montserrat_regular"
                android:text="Текущий срок аренды"
                android:textColor="#858585"
                android:textSize="14sp"
                app:layout_constraintEnd_toEndOf="@+id/krestYobannyiProlong"
                app:layout_constraintTop_toBottomOf="@+id/textProlongRent" />

            <TextView
                android:id="@+id/textHowSumDay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/montserrat_medium"
                android:text="Долго"
                android:textColor="#000000"
                android:textSize="15sp"
                app:layout_constraintEnd_toEndOf="@+id/textTermRent"
                app:layout_constraintTop_toBottomOf="@+id/textProduct" />

            <LinearLayout
                android:id="@+id/linearLayout5"
                android:layout_width="0dp"
                android:layout_height="62dp"

                android:layout_marginHorizontal="27dp"
                android:orientation="horizontal"
                app:layout_constraintBottom_toTopOf="@+id/frameLayoutCont"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textNameOfProduct">

                <FrameLayout
                    android:layout_width="83dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:layout_weight="1"
                    android:background="@drawable/choose_time_not_active">

                    <TextView
                        android:id="@+id/minus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:fontFamily="@font/montserrat_regular"
                        android:gravity="center"
                        android:text="-"
                        android:textColor="@color/black"
                        android:textSize="23sp" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="121dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginHorizontal="9dp"
                    android:background="@drawable/choose_time_not_active">

                    <TextView
                        android:id="@+id/time"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="top|center_horizontal"
                        android:layout_marginTop="11dp"
                        android:fontFamily="@font/montserrat_regular"
                        android:text="1 час"
                        android:textColor="@color/black"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/costs"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom|center_horizontal"
                        android:layout_marginBottom="10dp"
                        android:fontFamily="@font/montserrat_regular"
                        android:text="+80₽"
                        android:textColor="#838383"
                        android:textSize="14sp" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="83dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="end"
                    android:layout_weight="1"
                    android:background="@drawable/choose_time_not_active">

                    <TextView
                        android:id="@+id/plus"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center"
                        android:layout_weight="1"
                        android:fontFamily="@font/montserrat_regular"
                        android:gravity="center"
                        android:text="+"
                        android:textColor="@color/black"
                        android:textSize="23sp" />
                </FrameLayout>
            </LinearLayout>

            <FrameLayout
                android:id="@+id/frameLayoutCont"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="27dp"
                android:layout_marginBottom="30dp"
                android:background="@drawable/entrance_with_phone"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/textView9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:text="Продолжить"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </FrameLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>