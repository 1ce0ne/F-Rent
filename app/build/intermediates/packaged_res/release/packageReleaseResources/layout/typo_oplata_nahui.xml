<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <FrameLayout
        android:layout_width="355dp"
        android:layout_height="260dp"

        android:background="@drawable/chooze_size_not_active"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/linearLayout6"
                android:layout_width="0dp"
                android:layout_height="62dp"
                android:layout_marginHorizontal="27dp"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <TextView
                    android:id="@+id/textView11"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|start"

                    android:layout_weight="1"

                    android:fontFamily="@font/montserrat_bold"
                    android:text="Оформление заказа"
                    android:textColor="@color/black"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/krestYobannyi"
                    android:layout_width="13dp"
                    android:layout_height="13dp"

                    android:layout_gravity="center_vertical|end"
                    android:layout_weight="0"
                    app:srcCompat="@drawable/krest_blyat" />

            </LinearLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout"
                android:layout_width="0dp"

                android:layout_height="0dp"
                android:layout_marginHorizontal="27dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/linearLayout6">

                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="61dp"
                    android:layout_marginTop="25dp"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">


                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <ImageView
                            android:id="@+id/imageCardMir"
                            android:layout_width="38dp"
                            android:layout_height="16dp"
                            android:layout_gravity="center_vertical"
                            android:layout_marginStart="16dp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:srcCompat="@drawable/card_mir" />

                        <TextView
                            android:id="@+id/textCardSpisanya"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginBottom="19dp"
                            android:fontFamily="@font/montserrat_regular"
                            android:text="Карта списания"
                            android:textColor="#858585"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toStartOf="@+id/textCardBalance"
                            app:layout_constraintStart_toEndOf="@+id/imageCardMir"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/textCardSpisanyaNumber"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Тестовая"
                            android:textColor="#000000"
                            android:textSize="11sp"
                            app:layout_constraintStart_toStartOf="@+id/textCardSpisanya"
                            app:layout_constraintTop_toBottomOf="@+id/textCardSpisanya" />

                        <TextView
                            android:id="@+id/textCardBalance"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginEnd="25dp"
                            android:layout_marginBottom="19dp"
                            android:fontFamily="@font/montserrat_regular"
                            android:text="Баланс"
                            android:textColor="#858585"
                            android:textSize="12sp"
                            app:layout_constraintBottom_toBottomOf="parent"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent" />

                        <TextView
                            android:id="@+id/textCardBalanceSum"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="4dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="∞"
                            android:textColor="#000000"
                            android:textSize="11sp"
                            app:layout_constraintStart_toStartOf="@+id/textCardBalance"
                            app:layout_constraintTop_toBottomOf="@+id/textCardSpisanya" />


                    </androidx.constraintlayout.widget.ConstraintLayout>
                </FrameLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>

            <FrameLayout
                android:id="@+id/framePay"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginHorizontal="27dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/entrance_with_phone"
                app:layout_constraintBottom_toBottomOf="@+id/constraintLayout"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent">

                <TextView
                    android:id="@+id/textPay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical|center_horizontal"
                    android:text="Оплатить"
                    android:textColor="@color/white"
                    android:textSize="14sp" />
            </FrameLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>
    </FrameLayout>
</androidx.constraintlayout.widget.ConstraintLayout>