<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="500dp"
    android:background="@color/white">

    <!-- Первый элемент - Костюм Diesel -->
    <ImageView
        android:id="@+id/imageViewCostumeDiesel"
        android:layout_width="60dp"
        android:layout_height="80.4dp"
        android:layout_marginStart="15dp"
        android:layout_marginTop="15dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/drel_nahu" />

    <TextView
        android:id="@+id/textViewCategoryDiesel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:fontFamily="@font/montserrat_regular"
        android:text="Инструменты"
        android:textColor="#858585"
        android:textSize="12sp"
        app:layout_constraintStart_toEndOf="@+id/imageViewCostumeDiesel"
        app:layout_constraintTop_toTopOf="@+id/imageViewCostumeDiesel" />

    <TextView
        android:id="@+id/textViewNameDiesel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="9dp"
        android:fontFamily="@font/montserrat_regular"
        android:text="Перфоратор"
        android:textColor="#000000"
        android:textSize="14sp"
        app:layout_constraintStart_toEndOf="@+id/imageViewCostumeDiesel"
        app:layout_constraintTop_toBottomOf="@+id/textViewCategoryDiesel" />

    <FrameLayout
        android:id="@+id/frameLayoutDurationDiesel"
        android:layout_width="146dp"
        android:layout_height="29dp"
        android:layout_gravity="end|center_vertical"
        android:background="@drawable/check_tovar_blyat"
        app:layout_constraintBottom_toBottomOf="@+id/imageViewCostumeDiesel"
        app:layout_constraintStart_toStartOf="@+id/textViewNameDiesel"
        app:layout_constraintTop_toBottomOf="@+id/textViewNameDiesel">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/textViewDurationDiesel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#FFB700"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Проверка товара" />

        </LinearLayout>
    </FrameLayout>

    <TextView
        android:id="@+id/textViewPriceLabelDiesel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_regular"
        android:text="Цена"
        android:textColor="#858585"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/frameLayout5"
        app:layout_constraintTop_toTopOf="@+id/imageViewCostumeDiesel" />

    <TextView
        android:id="@+id/textViewPriceDiesel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_regular"
        android:text="340₽"
        android:textColor="#000000"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/textViewPriceLabelDiesel"
        app:layout_constraintTop_toBottomOf="@+id/textViewCategoryDiesel" />

    <TextView
        android:id="@+id/textViewSizeLabelDiesel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_regular"
        android:text="Мощность"
        android:textColor="#858585"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/textViewPriceLabelDiesel"
        app:layout_constraintTop_toTopOf="@+id/frameLayoutDurationDiesel" />

    <TextView
        android:id="@+id/textViewSizeDiesel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_regular"
        android:text="90нм"
        android:textColor="#000000"
        android:textSize="14sp"
        app:layout_constraintStart_toStartOf="@+id/textViewPriceLabelDiesel"
        app:layout_constraintTop_toBottomOf="@+id/textViewSizeLabelDiesel" />

    <TextView
        android:id="@+id/textSrokSdachi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_regular"
        android:text="Срок сдачи товара"
        android:layout_marginTop="17dp"
        android:textColor="#858585"
        android:textSize="12sp"
        app:layout_constraintStart_toStartOf="@+id/imageViewCostumeDiesel"
        app:layout_constraintTop_toBottomOf="@+id/imageViewCostumeDiesel" />

    <TextView
        android:id="@+id/textSrokSdachiTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_regular"
        android:text="10:23:00"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="@+id/textSrokSdachi"
        app:layout_constraintTop_toBottomOf="@+id/textSrokSdachi" />

    <TextView
        android:id="@+id/textAddressOfPostamat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_regular"
        android:text="Постамат"
        android:textColor="#858585"
        android:textSize="12sp"
        app:layout_constraintEnd_toStartOf="@+id/textViewSizeLabelDiesel"
        app:layout_constraintStart_toEndOf="@+id/textSrokSdachi"
        app:layout_constraintTop_toTopOf="@+id/textSrokSdachi" />

    <TextView
        android:id="@+id/textCity"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/montserrat_regular"
        android:text="«МДЦ «АРТЕК»\n«Русская поляна»"
        android:textColor="@color/black"
        android:textSize="15sp"
        app:layout_constraintStart_toStartOf="@+id/textAddressOfPostamat"
        app:layout_constraintTop_toBottomOf="@+id/textSrokSdachi" />

    <FrameLayout
        android:id="@+id/frameLayout34"
        android:layout_width="149dp"
        android:layout_height="43dp"
        android:layout_marginBottom="28dp"
        android:layout_marginTop="35dp"
        android:background="@drawable/chooze_size_not_active"
        app:layout_constraintStart_toStartOf="@+id/textSrokSdachiTime"
        app:layout_constraintTop_toBottomOf="@+id/textSrokSdachiTime">

        <TextView
            android:id="@+id/textView9"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center_horizontal"
            android:text="Продлить"
            android:textColor="@color/black"
            android:textSize="14sp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayout46"
        android:layout_width="149dp"
        android:layout_height="43dp"
        android:layout_marginStart="7dp"
        android:background="@drawable/chooze_size_not_active"
        app:layout_constraintStart_toEndOf="@+id/frameLayout34"
        app:layout_constraintTop_toTopOf="@+id/frameLayout34">

        <TextView
            android:id="@+id/textView10"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|center_horizontal"
            android:text="Вернуть товар"
            android:textColor="@color/black"
            android:textSize="14sp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/frameLayout5"
        android:layout_width="43dp"
        android:layout_height="43dp"
        android:layout_marginStart="7dp"
        android:background="@drawable/chooze_size_not_active"
        app:layout_constraintStart_toEndOf="@+id/frameLayout46"
        app:layout_constraintTop_toTopOf="@+id/frameLayout34">

        <ImageView
            android:id="@+id/imageView2"
            android:layout_width="19dp"
            android:layout_height="17dp"
            android:layout_gravity="center"
            app:srcCompat="@drawable/delivery_time" />
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="0.8dp"
        android:background="#BCBCBC"
        android:layout_marginTop="17dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/frameLayout34">

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>